{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "roles", "subject", "topic", "difficulty", "statement", "options", "answer", "explanation", "whyWrong", "sources", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 8},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "subject": {"type": "string", "minLength": 3},
    "topic": {"type": "string", "minLength": 3},
    "difficulty": {"enum": ["easy", "medium", "hard", "very-hard"]},
    "statement": {"type": "string", "minLength": 80},
    "options": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 3}},
    "answer": {"type": "integer", "minimum": 0, "maximum": 4},
    "explanation": {"type": "string", "minLength": 120},
    "whyWrong": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 20}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "locator"], "properties": {"title": {"type": "string"}, "locator": {"type": "string"}, "url": {"type": "string"}}}},
    "status": {"enum": ["draft", "review", "approved", "rejected"]}
  }
}
