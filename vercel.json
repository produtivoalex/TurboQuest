{
  "functions": {
    "api/content-library.js": {
      "includeFiles": ["content/**"]
    }
  },
  "rewrites": [
    { "source": "/sw.js", "destination": "/dist/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/dist/manifest.webmanifest" },
    { "source": "/(.*)", "destination": "/dist/index.html" }
  ]
}
